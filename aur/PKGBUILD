# Maintainer: phoscoder <phoscoder@users.noreply.github.com>
pkgname=chelete-bin
pkgver=0.6.1
pkgrel=1
pkgdesc='Keyboard-driven personal finance tracker for Omarchy'
arch=('x86_64')
url='https://github.com/phoscoder/chelete'
license=('MIT')
depends=('vulkan-icd-loader' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'fontconfig' 'libx11' 'libxcb')
provides=('chelete')
conflicts=('chelete')

source=("${url}/releases/download/v${pkgver}/chelete_${pkgver}_linux_x86_64.tar.gz")

sha256sums=('SKIP')

package() {
    cd "${srcdir}/chelete_${pkgver}_linux_x86_64"
    install -Dm755 chelete "${pkgdir}/usr/bin/chelete"
    install -Dm644 chelete.desktop "${pkgdir}/usr/share/applications/chelete.desktop"
    install -Dm644 chelete.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/chelete.png"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
